#!name=InPTT 自動簽到
#!desc=自動擷取 InPTT Token，並每日 00:20 自動簽到
#!author=howsingsong

[Script]
InPTT Token 擷取 = type=http-request,pattern=^https:\/\/api\.inptt\.cc\/,script-path=https://raw.githubusercontent.com/howsingsong/inptt-surge/main/inptt_token.js

InPTT 每日自動簽到 = type=cron,cronexp="20 0 * * *",script-path=https://raw.githubusercontent.com/howsingsong/inptt-surge/main/inptt_checkin.js,wake-system=true,timeout=20

[MITM]
hostname = %APPEND% api.inptt.cc
